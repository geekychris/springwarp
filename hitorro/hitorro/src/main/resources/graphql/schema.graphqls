type Department {
  id: ID!
  name: String!
  location: String
  employees: [Employee!]
  description: String
}

type Employee {
  id: ID!
  firstName: String!
  lastName: String!
  email: String!
  phoneNumber: String
  salary: Float
  hireDate: String
  department: Department
  position: String
}

input DepartmentInput {
  name: String!
  location: String
  description: String
}

input EmployeeInput {
  firstName: String!
  lastName: String!
  email: String!
  phoneNumber: String
  salary: Float
  hireDate: String
  departmentId: ID!
  position: String
}

input DepartmentUpdateInput {
  id: ID!
  name: String
  location: String
  description: String
}

input EmployeeUpdateInput {
  id: ID!
  firstName: String
  lastName: String
  email: String
  phoneNumber: String
  salary: Float
  hireDate: String
  departmentId: ID
  position: String
}

type Query {
  # Department queries
  departments: [Department!]!
  department(id: ID!): Department
  departmentByName(name: String!): Department
  departmentEmployees(departmentId: ID!): [Employee!]!

  # Employee queries
  employees: [Employee!]!
  employee(id: ID!): Employee
  employeesByDepartment(departmentId: ID!): [Employee!]!
  employeeByEmail(email: String!): Employee
}

type Mutation {
  # Department mutations
  createDepartment(department: DepartmentInput!): Department!
  updateDepartment(department: DepartmentUpdateInput!): Department!
  deleteDepartment(id: ID!): Boolean!

  # Employee mutations
  createEmployee(employee: EmployeeInput!): Employee!
  updateEmployee(employee: EmployeeUpdateInput!): Employee!
  deleteEmployee(id: ID!): Boolean!
  assignEmployeeToDepartment(employeeId: ID!, departmentId: ID!): Employee!
}

